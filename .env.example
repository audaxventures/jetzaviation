# Resend API key used to send contact form submissions.
# Get one at https://resend.com/api-keys after creating a free Resend account.
RESEND_API_KEY=

# Address that receives contact form submissions.
CONTACT_TO_EMAIL=mike@jetzaviation.com

# "From" address used when sending. Must be on a domain verified in Resend
# (https://resend.com/domains). Until jetzaviation.com is verified, you can
# leave this on Resend's shared sandbox sender below.
CONTACT_FROM_EMAIL="Jetz Aviation Website <onboarding@resend.dev>"
